RUNTIME_PROFILE_PATH=config/runtime_profile.json
ALPHA=0.1
MAX_SET_SIZE=4
ENABLE_ABSTAIN=true
# Deprecated compatibility flag. ATTRIBUTE_PROVIDER takes precedence.
USE_MOCK_LLM=true
ATTRIBUTE_PROVIDER=mock
ATTRIBUTE_MODEL=Qwen/Qwen3.5-9B
ATTRIBUTE_MODEL_REVISION=c202236235762e1c871ad0ccb60c8ee5ba337b9a
ATTRIBUTE_QUANTIZATION=nf4
ATTRIBUTE_COMPUTE_DTYPE=float16
ATTRIBUTE_DEVICE=auto
ATTRIBUTE_MAX_INPUT_TOKENS=4096
ATTRIBUTE_MAX_NEW_TOKENS=192
CLASSIFIER_MODEL_TYPE=embedding
STRICT_ARTIFACT_METADATA=true
CLASSIFIER_ARTIFACT_MISMATCH_POLICY=auto_rebuild
ENABLE_SEMANTIC_SCORER=false
SEMANTIC_PROVIDER=sentence_transformers
SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
SEMANTIC_DEVICE=cpu
SEMANTIC_CONSISTENCY_THRESHOLD=0.4
SEMANTIC_MAX_RETRIES=1

# Local development keeps authentication disabled. Production forces it on.
UAMAS_ENV=development
UAMAS_AUTH_ENABLED=false
UAMAS_ADMIN_TOKEN=
UAMAS_API_TOKEN=
UAMAS_SESSION_SECRET=
UAMAS_COOKIE_SECURE=false
UAMAS_SESSION_TTL_SECONDS=28800
UAMAS_MAX_REQUEST_BYTES=1000000
UAMAS_ALLOWED_HOSTS=

UAMAS_DB_PATH=data/uamas.db
WORKFLOW_RETENTION_DAYS=90
RESOLVED_REVIEW_RETENTION_DAYS=0
CLEANUP_BATCH_SIZE=500
CLEANUP_BACKUP_ENABLED=true
CLEANUP_BACKUP_DIR=data/backups
