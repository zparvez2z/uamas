GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4.1

RUNTIME_PROFILE_PATH=config/runtime_profile.json
ALPHA=0.1
MAX_SET_SIZE=4
LLM_MAX_RETRIES=2
ENABLE_ABSTAIN=true
USE_MOCK_LLM=false
CLASSIFIER_MODEL_TYPE=embedding
STRICT_ARTIFACT_METADATA=true
CLASSIFIER_ARTIFACT_MISMATCH_POLICY=auto_rebuild
ENABLE_SEMANTIC_SCORER=true
GITHUB_MODELS_EMBEDDING_MODEL=openai/text-embedding-3-small
SEMANTIC_CONSISTENCY_THRESHOLD=0.4
SEMANTIC_MAX_RETRIES=1

# Local development keeps authentication disabled. Production forces it on.
UAMAS_ENV=development
UAMAS_AUTH_ENABLED=false
UAMAS_ADMIN_TOKEN=
UAMAS_API_TOKEN=
UAMAS_SESSION_SECRET=
UAMAS_COOKIE_SECURE=false
UAMAS_SESSION_TTL_SECONDS=28800
UAMAS_MAX_REQUEST_BYTES=1000000
UAMAS_ALLOWED_HOSTS=

UAMAS_DB_PATH=data/uamas.db
WORKFLOW_RETENTION_DAYS=90
RESOLVED_REVIEW_RETENTION_DAYS=0
CLEANUP_BATCH_SIZE=500
CLEANUP_BACKUP_ENABLED=true
CLEANUP_BACKUP_DIR=data/backups
